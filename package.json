{
  "name": "alentapp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:api": "vitest run packages/api",
    "test:api:watch": "vitest packages/api",
    "test:api:ui": "vitest --ui",
    "test:api:coverage": "DATABASE_URL=\"postgresql://admin:password123@localhost:5432/alentapp_test_db\" vitest run --coverage packages/api",
    "test:payments": "vitest run packages/api/src/domain/payments packages/api/src/application/payments",
    "test:payments:all": "DATABASE_URL=\"postgresql://admin:password123@localhost:5432/alentapp_test_db\" vitest run packages/api/src/domain/payments packages/api/src/application/payments packages/api/src/delivery/payments",
    "test:payments:integration": "DATABASE_URL=\"postgresql://admin:password123@localhost:5432/alentapp_test_db\" vitest run packages/api/src/delivery/payments/PaymentController.integration.test.ts",
    "test:web": "npm test --workspace=packages/web",
    "e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "e2e:fullstack:ui": "npm run e2e:fullstack -- --ui",
    "e2e:fullstack:headed": "npm run e2e:fullstack -- --headed",
    "e2e:fullstack:ui:run": "npm run e2e:fullstack:up && npm run e2e:fullstack:ui",
    "e2e:fullstack:headed:run": "npm run e2e:fullstack:up && npm run e2e:fullstack:headed & npm run e2e:fullstack:down",
    "e2e:fullstack:up": "docker compose -f docker-compose.e2e.yml --project-name alentapp-e2e up -d --build",
    "e2e:fullstack:down": "docker compose -f docker-compose.e2e.yml --project-name alentapp-e2e down -v",
    "e2e:fullstack:run": "npm run e2e:fullstack:up && npm run e2e:fullstack && npm run e2e:fullstack:down",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^4.1.5",
    "husky": "^9.1.7",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
