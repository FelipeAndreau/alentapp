{
    "id": null,
    "uid": "red-lockers",
    "title": "RED — Alentapp Lockers",
    "tags": [
        "lockers",
        "red",
        "observability"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "5s",
    "annotations": {
        "list": []
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "id": 1,
            "title": "Requests por segundo",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{route=~\"/api/v1/lockers.*\"}[1m])) by (method, route)",
                    "legendFormat": "{{method}} {{route}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 2,
            "title": "Tasa de error (%)",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_errors{route=~\"/api/v1/lockers.*\"}[1m])) / sum(rate(http_requests_total{route=~\"/api/v1/lockers.*\"}[1m])) * 100",
                    "legendFormat": "Error %"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            }
        },
        {
            "id": 3,
            "title": "Latencia p95 / p99",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_bucket{route=~\"/api/v1/lockers.*\"}[5m])) by (le))",
                    "legendFormat": "p95"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_bucket{route=~\"/api/v1/lockers.*\"}[5m])) by (le))",
                    "legendFormat": "p99"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            }
        },
        {
            "id": 4,
            "title": "Por código de estado",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "sum by (status) (rate(http_requests_total{route=~\"/api/v1/lockers.*\"}[5m]))",
                    "legendFormat": "{{status}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            }
        },
        {
            "id": 5,
            "title": "Memoria del proceso (MB)",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "process_memory_usage / 1024 / 1024",
                    "legendFormat": "Heap Used (MB)"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            }
        },
        {
            "id": 6,
            "title": "Endpoints más lentos (top 5)",
            "type": "bargauge",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "topk(5, avg by (route) (rate(http_request_duration_sum{route=~\"/api/v1/lockers.*\"}[5m])) / avg by (route) (rate(http_request_duration_count{route=~\"/api/v1/lockers.*\"}[5m])))",
                    "legendFormat": "{{route}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 16
            }
        }
    ]
}